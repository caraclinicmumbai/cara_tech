// Cara Clinic — Sales Automation Platform
// Database schema. See Tech Stack & Build Guide §6 (Key Tables).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A captured sales lead — the central source of truth (§6.1).
model Lead {
  id            String  @id @default(cuid())
  name          String
  phone         String // E.164 format for ElevenLabs to dial, e.g. +919876543210
  email         String?
  interest      String? // free-text clinic interest, e.g. "Hair treatment"
  source        String? // web_form | referral | manual | walk_in | facebook | instagram | google
  status        String  @default("new") // new | manual_followup | called | confirmed | rescheduled | unreachable | not_interested | lost
  interestLevel String? // high | medium | low — set by call outcome

  // ── Sales pipeline stage (human-facing, §3.1) — distinct from `status` (the
  //    internal automation state). Auto-advanced FORWARD-ONLY by call outcomes
  //    and editable by staff. Keys in lib/leadStages.ts. ──
  stage String  @default("ai_contacted") // ai_contacted | ai_attempted_unreachable | communication_not_established | human_callback_pending | in_consideration | appointment_scheduled | consultation_done | converted | lost
  // What the lead asked for in the call (e.g. "Hair transplant") — AI-filled from
  // the post-call write-back, staff-editable. Free text.
  tag   String?

  // Short staff remark shown inline on the leads dashboard — the one-line "where
  // this stands" note, edited straight from the table. DISTINCT from LeadComment:
  // that's an append-only thread with authors; this is a single mutable field.
  remark String?

  // ── Stage-age tracking (§3.1) — `stageChangedAt` is set whenever `stage` moves
  //    (auto-advance or manual), so the worker can flag a lead "stuck in stage"
  //    past the SLA and alert the counsellor. `stageStuckNotifiedAt` dedups that
  //    alert per stall; it's reset to null on every stage change. ──
  stageChangedAt       DateTime? @default(now())
  stageStuckNotifiedAt DateTime?

  // ── Lost (§3.1) — moving the stage to "lost" needs a preset `lostTag` and/or a
  //    free-text `lostReason` review. A tag makes the review optional; with no tag
  //    a written reason is required. Both cleared if the lead is reactivated. ──
  lostTag       String? // one of LOST_PRESET_TAGS (e.g. "pricing issue")
  lostReason    String? // free-text review (optional when a tag is set)
  lostAt        DateTime?
  // True when the lead was marked Lost BEFORE completing a consultation (a
  //    premature loss the counsellor was alerted to). Counted in the daily digest.
  prematureLost Boolean   @default(false)
  // ── Win-back (Phase 2 §follow-up) — when this lead was last auto-enrolled in the
  //    90-day Win-Back campaign. Dedups the daily sweep (one win-back per lost event:
  //    only re-enrol if the lead was lost AGAIN after the last win-back). ──
  lastWinBackAt DateTime?

  // ── AI→human handover (§3.1) — when an AI call hits a trigger (pricing/clinical
  //    question, distress, wants-human, competitor, unresolved objection, CQS≥75,
  //    unsupported language, hearing-impaired, abusive, wrong-person), the lead is
  //    routed to the sales team: AI drip stops, Slack alert fires, reason logged. ──
  needsHandover    Boolean   @default(false)
  handoverReason   String? // human-readable reason(s), shown to the counsellor
  handoverAt       DateTime?
  handoverTriggers String[] // machine keys of the triggers that fired

  // ── Assignment (§3.1) — the sales rep who OWNS this lead. Assigned round-robin
  //    at intake (every lead gets an owner for "my leads" scoping); a later
  //    handover notifies this existing owner rather than re-assigning. ──
  assignedRepId String?
  assignedRep   SalesRep? @relation("LeadAssignee", fields: [assignedRepId], references: [id], onDelete: SetNull)
  assignedAt    DateTime?

  // Which login created this lead (§3.1 RBAC) — used for Front-Desk "own leads"
  // scoping (they see what they entered). Null for AI/ad/web-intake leads.
  createdById String?

  // ── Branch (Phase 2) — nullable scaffold. One branch for now; every branch-scoped
  //    feature (routing, dashboards, attribution, toggles) hangs off this later. ──
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // ── Protection flags (Phase 2 §compliance) — persistent, call-BLOCKING flags,
  //    distinct from transient handoverTriggers. Any of these true = the "call"
  //    action is refused unless a manager overrides with a logged reason. A
  //    possible-minor / legal-threat / complaint also excludes the lead from ALL
  //    campaigns. Cleared only by a Branch Manager / Admin (audited). ──
  possibleMinor     Boolean @default(false)
  hearingImpaired   Boolean @default(false)
  legalThreatFreeze Boolean @default(false)
  complaintOpen     Boolean @default(false)
  protectionNote    String? // free-text context for whoever set/clears a flag

  // ── Per-channel consent (Phase 2 §consent) — consent is not one bit. Someone can
  //    allow a nurse's call but not marketing. Checked before EVERY message/call,
  //    alongside the hard `optedOut` suppression. Null = unknown (treat as no for
  //    marketing). `onDnd` caches the last Do-Not-Call registry lookup. ──
  consentCall      Boolean?
  consentMarketing Boolean?
  consentUpdatedAt DateTime?
  onDnd            Boolean   @default(false)
  dndCheckedAt     DateTime?

  // ── Clinical consent (§post-sales) — DELIBERATELY SEPARATE from marketing consent.
  //    Post-op care messages are medical, not promotional: they go out even to someone
  //    who opted out of promotions, governed by clinical consent alone. Null = not
  //    explicitly recorded, which for a patient with a converted quote is treated as
  //    consenting (they are under the clinic's care). Only an explicit `false` blocks
  //    care messages. See lib/postSales/checkins.ts. ──
  consentClinical Boolean?
  // The language the patient is comfortable in, e.g. "Hindi", "Marathi" (§post-sales
  // handover summary). Carried into the handover so post-sales never has to guess.
  preferredLanguage String?

  // ── Opt-out / suppression (§3.1.10) — hard flag: once true, NO outreach (calls,
  //    retries, callbacks) is allowed. Set on "not interested" or WhatsApp STOP.
  //    NOTE: this is a MARKETING/sales suppression. It does not suppress clinical
  //    post-op care messages (see `consentClinical` above). ──
  optedOut       Boolean   @default(false)
  optedOutAt     DateTime?
  optedOutReason String?

  // ── Held for review (§3.1) — anti-spam: a burst of submissions from one IP
  //    (>5 in 10 min) captures the lead but flags it for a human to vet before
  //    any AI call fires. Held leads sit in the manual_followup queue. ──
  heldForReview Boolean   @default(false)
  heldAt        DateTime?
  heldReason    String?

  // ── Consent capture (§3.1.13) — for walk-in/front-desk, the iPad/written
  //    consent form is collected at the clinic BEFORE the record is created. ──
  consentMethod String? // ipad | written (walk-in) | digital_form (web/Meta/Google/WhatsApp §C2)
  consentAt     DateTime? // when consent was captured
  consentBy     String? // staff member (email) who captured the consent

  // ── Callback requested by the lead during a call (§3.1.2) ──
  callbackAt DateTime? // specific time the lead asked to be called back

  // ── Duplicate detection (§3.1.1) — points to the pre-existing lead this one
  //    duplicates (matched on phone/email). Duplicates are not auto-called;
  //    they go to the manual queue for counsellor review/merge. ──
  duplicateOfId String?
  duplicateOf   Lead?   @relation("LeadDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Lead[]  @relation("LeadDuplicates")

  // ── Attribution (set by ad / form intake adapters) ──
  externalId String? // provider's lead id (Meta leadgen_id, Google lead_id) — dedup key
  campaign   String? // campaign id/name
  adId       String? // ad / adgroup / creative id

  // ── Soft delete / trash (§3.1) — a staff-removed lead. When set it's excluded
  //    from lists, metrics, dedup, and calling; it shows in the Deleted section,
  //    where it can be restored (deletedAt→null) or permanently removed. ──
  deletedAt DateTime?
  deletedBy String? // staff email who moved it to trash

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls               Call[]
  messages            Message[]
  quotes              Quote[]
  chatbotSessions     ChatbotSession[]
  accessGrants        LeadAccessGrant[]
  campaignEnrollments CampaignEnrollment[]
  comments            LeadComment[]
  followUpSteps       LeadFollowUpStep[]
  postSalesJourneys   PostSalesJourney[]
  postSalesCheckIns   PostSalesCheckIn[]
  notifications       Notification[]
  chatReads           ChatRead[]

  @@index([status])
  @@index([phone])
  @@index([source])
  @@index([externalId])
  @@index([duplicateOfId])
  @@index([heldForReview])
  @@index([stage])
  @@index([stageChangedAt])
  @@index([needsHandover])
  @@index([assignedRepId])
  @@index([deletedAt])
}

/// A sales rep / telecaller who receives AI→human handovers (§3.1). Handovers are
/// distributed round-robin (least-recently-assigned first). `slackUserId` enables
/// an individual Slack DM; `phone` is the click-to-call number.
model SalesRep {
  id             String    @id @default(cuid())
  name           String
  slackUserId    String? // Slack member id (e.g. U0123ABCD) for the individual DM
  phone          String // E.164, for click-to-call
  active         Boolean   @default(true)
  // Sales head (§3.1): a manager, NOT a line telecaller. Excluded from the
  // round-robin handover rota, and pinged ONLY on CQS extremes (very high /
  // very low) — the exceptional wins and the quality failures worth their time.
  salesHead      Boolean   @default(false)
  lastAssignedAt DateTime? // round-robin cursor
  createdAt      DateTime  @default(now())

  // ── Availability / presence (§presence "Knowing who's available") ──
  // Day-to-day presence, DISTINCT from `active` (the admin employment/enabled flag).
  // Presence PREFERS an "available" rep in the round-robin, but never blocks ownership:
  // pickOwnerRep falls back to any active rep so a new lead is never left unowned, while
  // "act on it now" routing (handover cover, inbound calls) sticks to who's actually free.
  //   available | in_consultation | break | offline
  availability   String   @default("available")
  availabilityAt DateTime @default(now()) // when availability last changed
  // Heartbeat from the app — drives the 15-min auto-offline sweep (during work hours).
  lastActivityAt DateTime @default(now())
  // True while auto-set to in_consultation by a live click-to-call, so the call-end
  // webhook reverts to available (and a manual Break isn't clobbered by a stray revert).
  onCall         Boolean  @default(false)
  // Skill/speciality (§presence) — an offline counsellor's leads prefer a colleague
  // with the SAME speciality; null = generalist (eligible only as a fallback match).
  speciality     String?

  // Branch (Phase 2) — nullable scaffold; the rep's home branch for routing/scoping.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  leads        Lead[]             @relation("LeadAssignee")
  handledCalls Call[]             @relation("CallHandler")
  ownedQuotes  Quote[]            @relation("QuoteOwner")
  followUpSteps LeadFollowUpStep[] @relation("FollowUpOwner")
  user         User? // the login account linked to this rep (§3.1 RBAC)

  @@index([active, lastAssignedAt])
  // Fast lookup for the round-robin (available reps) and the idle-sweep.
  @@index([availability, salesHead, active])
  @@index([lastActivityAt])
}

/// Per-lead follow-up roadmap step (§follow-up roadmap). An ordered, editable
/// sales-roadmap entry with its own status + accountable owner. Seeded from a
/// standard template at intake (lib/followups.ts) and hand-editable thereafter.
/// "Missed" (overdue) is DERIVED at read time from dueAt vs now — never stored —
/// so only pending | done | skipped are persisted.
model LeadFollowUpStep {
  id            String    @id @default(cuid())
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  order         Int // position in the lead's roadmap (0-based)
  title         String
  channel       String    @default("custom") // ai_call | call | whatsapp | quote | custom
  dueAt         DateTime?
  status        String    @default("pending") // pending | done | skipped
  completedAt   DateTime?
  completedById String? // User.id who marked it done/skipped (audit convenience)
  // Accountable actor. ownerKind = ai | rep | sales_head. For rep/sales_head the
  // ownerRepId points at the SalesRep; for ai it's null (system/ElevenLabs).
  ownerKind     String    @default("rep")
  ownerRepId    String?
  ownerRep      SalesRep? @relation("FollowUpOwner", fields: [ownerRepId], references: [id], onDelete: SetNull)
  source        String    @default("template") // template | manual
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([leadId, order])
  @@index([ownerRepId])
}

/// A single WhatsApp message exchanged with a lead (§3.1.3). Both automated
/// (system/AI-sent) and manual (agent-sent) messages, plus every inbound reply,
/// are stored here so the lead profile shows ONE continuous thread on ONE number
/// — any agent can pick up where the last left off (continuity across turnover).
model Message {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel      String   @default("whatsapp") // whatsapp (room for sms/etc. later)
  direction    String // inbound | outbound
  waId         String?  @unique // Meta wamid — dedups inbound retries + links status updates
  type         String   @default("text") // text | template | image | document | audio | video | button | interactive
  body         String? // text/caption, or a short summary for non-text types
  mediaId      String? // Meta media id (download via Graph API — Phase 2)
  mediaUrl     String? // stored/resolved media URL once downloaded
  templateName String? // outbound template name (type=template)
  status       String? // outbound: queued|sent|delivered|read|failed ; inbound: received
  error        String? // failure detail (status=failed)
  automated    Boolean  @default(false) // true = system/AI-sent; false = manual agent / inbound
  sentBy       String? // agent email for manual outbound; null for inbound/automated
  createdAt    DateTime @default(now())
  // Touched on every write (including delivery-status updates). The live chat
  // stream (§3.1.3 realtime) uses it as its cursor, so an agent sees a
  // sent→delivered→read transition as well as brand-new messages.
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([leadId, createdAt])
  @@index([leadId, updatedAt])
  @@index([status])
}

/// A single AI voice call placed against a Lead (§6.2).
model Call {
  id           String  @id @default(cuid())
  leadId       String
  lead         Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // initial | reconfirmation | human_handover — outbound; plus the two inbound kinds
  // from the clinic line (§presence): a connected patient call, and a voicemail.
  callType     String // initial | reconfirmation | human_handover | inbound | inbound_voicemail
  transcript   String?
  outcome      String? // confirmed | no_answer | rescheduled | not_interested
  sentiment    String? // positive | neutral | negative
  duration     Int? // seconds
  // Provider correlation ids are UNIQUE so a retried/duplicate webhook (ElevenLabs
  // + n8n + Twilio all retry on timeout/5xx) can't create a second Call and
  // re-run the pipeline. NULLs are allowed and don't collide (Postgres).
  elevenlabsId String? @unique // ElevenLabs conversation/call id
  recordingUrl String? // Twilio recording URL for human-handover calls (§3.1)
  providerSid  String? @unique // Twilio CallSid (correlation)
  cqs          Int? // Conversation Quality Score 0–100, judged by Claude (§3.1)
  cqsBreakdown Json? // per-dimension scores + objection type + summary

  // Recording-consent disclosure (§compliance C1). Whether a "this call is recorded"
  // disclosure was made / acknowledged on THIS call: AI calls set it from the agent's
  // `recording_consent` data point; human-handover calls disclose via a callee whisper
  // (so it's true when one was placed). Null = unknown / not disclosed.
  recordingConsent Boolean?

  // Who handled a human-handover call — the rep who initiated the click-to-call
  // (from the Slack button or the in-app button). Null for AI calls. (§3.1)
  handledById String?
  handledBy   SalesRep? @relation("CallHandler", fields: [handledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([callType])
}

/// A staff note / review on a lead (§notes). Free-text, human-authored context that
/// isn't a structured field — a call recap, patient preference, or a manager's review.
/// DISTINCT from the AuditLog (automatic + immutable): comments are written by staff
/// and can be deleted by their author or a manager. `authorId`/`authorName` mirror the
/// AuditLog convention (no FK): the name is snapshotted so attribution survives if the
/// login is later removed.
model LeadComment {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId   String? // User.id who wrote it (null if the account was later removed)
  authorName String? // snapshot of the author's name/email at write time
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([leadId, createdAt])
}

// ── Auth (NextAuth.js / Auth.js — §2.5) ──────────────────────────────

/// Application user (a login). `role` drives role-based access (§3.1 RBAC).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // RBAC role. See lib/rbac.ts for the capability map:
  //   front_desk | telecaller | branch_manager | sales_head | crm_admin
  role          String    @default("telecaller")
  passwordHash  String? // for credentials login (optional)

  // Link this login to a sales-rep identity (§3.1) — so "my leads" scoping and
  // handover/click-to-call attribution resolve to the person. Telecallers (and
  // anyone who can be assigned leads) have one; pure admins may not.
  salesRepId String?   @unique
  salesRep   SalesRep? @relation(fields: [salesRepId], references: [id], onDelete: SetNull)

  // Home branch (§branches) — the login's clinic; a quote they raise inherits it.
  branchId String?
  branch   Branch? @relation("UserHomeBranch", fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  // Branches this user manages (Branch.managerId points here).
  managedBranches Branch[] @relation("BranchManager")

  // Temporary lead-access grants received (§handover — cover a colleague's lead).
  leadGrants LeadAccessGrant[] @relation("LeadGrantee")

  // In-app bell notifications addressed to this login (§handover).
  notifications Notification[]

  // Per-conversation read state for the WhatsApp inbox (§whatsapp inbox).
  chatReads ChatRead[]

  // ── Post-sales assignments (§post-sales) — the clinical team on a journey. A
  //    doctor/OT lead/consultant is a staff LOGIN (role doctor | ot_team |
  //    post_sales_consultant), so the person accountable for a stage can act on it. ──
  doctorJourneys     PostSalesJourney[] @relation("JourneyDoctor")
  otJourneys         PostSalesJourney[] @relation("JourneyOtLead")
  consultantJourneys PostSalesJourney[] @relation("JourneyConsultant")
}

/// A temporary grant of access to a lead (§handover) — lets a counsellor act on a
/// colleague's lead WITHOUT changing ownership (e.g. cover while the owner is on leave).
/// A manager/admin grants it with a reason and an optional expiry; it can be revoked
/// early. An "active" grant (revokedAt null and not past expiry) widens the grantee's
/// lead scope (see lib/authz.ts). Every grant + revoke is written to AuditLog.
model LeadAccessGrant {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  granteeId   String // User.id granted access
  grantee     User      @relation("LeadGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  grantedById String? // User.id who granted (manager/admin)
  reason      String?
  expiresAt   DateTime? // null = until revoked
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([granteeId])
  @@index([revokedAt])
}

/// An in-app notification for one staff login — what the bell in the header shows
/// (§handover). Written whenever something needs a specific person's attention: the
/// AI hands a lead to its owner, or a colleague is asked to cover an away owner.
///
/// Deliberately in-app and durable rather than a transient toast: a telecaller who
/// was away must still see the handover when they sign back in. Slack alerts (if
/// configured) are an ADDITION to this, never a replacement.
model Notification {
  id     String @id @default(cuid())
  userId String // recipient login
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What happened: handover | handover_cover  (room for sla / mention / … later).
  kind  String
  title String
  body  String?

  // The lead this is about — clicking the notification opens it. Nullable so a
  // future non-lead notification still fits; cascades if the lead is purged.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Dedup key so a repeated trigger (a second handover on the same cycle, a retried
  // webhook) doesn't stack identical bells. Null = never deduped.
  dedupeKey String? @unique

  readAt    DateTime? // null = unread; drives the bell's badge count
  createdAt DateTime  @default(now())

  // The bell's query: this user's newest first, unread first.
  @@index([userId, readAt, createdAt])
  @@index([leadId])
}

/// An invoice raised by the billing system, attached to the QUOTE it paid for
/// (§billing). Never to the lead: a patient can have a transplant invoiced at Andheri
/// and a PRP course at Bandra, and both branches earned their credit — a lead-level
/// field would force us to pick one and misreport the other.
///
/// This is the CRM's definition of "converted": the quote reaches `converted` because
/// an invoice exists for it, and the invoicing branch is read from here rather than
/// typed by anyone.
///
/// **No card or bank details, ever.** The fields below are what a CRM needs to
/// attribute revenue — a number, an amount, a branch, a date. Payment instruments stay
/// in the billing system.
model Invoice {
  id String @id @default(cuid())

  /// The billing system's own invoice number, as printed for the patient. Unique so a
  /// retried webhook can't create a second invoice for the same document.
  number String @unique

  /// The billing system's internal id for this invoice, when it sends one — a second
  /// idempotency key for providers whose number is assigned late.
  externalId String? @unique

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// The branch that RAISED the invoice — the one that earns the credit for this
  /// quote (§branch credit). Comes from billing; never entered in the CRM.
  branchId String
  branch   Branch @relation("InvoiceBranch", fields: [branchId], references: [id])

  /// Invoiced amount in whole rupees, and the currency it was raised in.
  amount   Int
  currency String @default("INR")

  /// When the invoice was raised in the billing system (not when we heard about it).
  issuedAt DateTime

  /// Which system sent this — "zenoti", "manual_admin", etc. Recorded so a
  /// hand-entered override is distinguishable from a billed fact.
  source String @default("billing")

  /// Set when an Admin recorded the invoice by hand instead of billing sending it,
  /// with the reason they gave. Null for a genuine billing webhook.
  overrideReason String?

  receivedAt DateTime @default(now())

  @@index([quoteId])
  @@index([branchId])
  @@index([issuedAt])
}

/// A branch disputing who earned the credit for one quote (§branch credit).
///
/// The rule: the branch that RAISED THE INVOICE gets the credit, no exceptions — the
/// system reads it from the invoice so nobody types it and nobody argues about it. The
/// one release valve is this: a branch that believes the credit is theirs has **7 days**
/// to say so, the Sales Head decides once, and the decision is final and logged.
///
/// One dispute per quote, enforced by the unique key. "Final" means final: a decided
/// dispute is never reopened, and a second attempt is refused rather than quietly
/// starting a fresh argument.
model QuoteCreditDispute {
  id      String @id @default(cuid())
  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// The branch claiming the credit, and the branch that held it when the dispute was
  /// raised — recorded so the trail reads correctly even if the credit later moves.
  claimantBranchId String
  claimantBranch   Branch @relation("DisputeClaimant", fields: [claimantBranchId], references: [id])
  creditedBranchId String
  creditedBranch   Branch @relation("DisputeCredited", fields: [creditedBranchId], references: [id])

  /// Who raised it, when, and why (a reason is mandatory).
  raisedById String?
  raisedAt   DateTime @default(now())
  reason     String

  /// The deadline this dispute was raised against — 7 days from the credit landing.
  /// Stored rather than recomputed so a later change to the window can't retroactively
  /// invalidate a dispute that was in time when it was made.
  windowEndsAt DateTime

  /// open | upheld | rejected. `upheld` moves the credit to the claimant.
  status String @default("open")

  decidedById String?
  decidedAt   DateTime?
  /// The Sales Head's reasoning. Mandatory on a decision — this is the record that
  /// settles the argument.
  decisionNote String?

  @@index([status])
  @@index([claimantBranchId])
}

/// How far a staff login has read a lead's WhatsApp thread (§whatsapp inbox) — the
/// "unread" state behind the WhatsApp tab's conversation list.
///
/// Per USER rather than per lead: the clinic shares one WhatsApp number, but two
/// counsellors working side by side each need their own sense of what's new, and one
/// of them opening a chat shouldn't clear the other's badge.
model ChatRead {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Everything inbound at or before this instant has been seen by this user.
  lastReadAt DateTime

  @@unique([userId, leadId])
  @@index([userId])
}

/// Admin-editable role → capability overrides (§3.1 Hierarchy settings). One row per
/// editable role (front_desk | telecaller | branch_manager | sales_head). crm_admin is
/// always all-access and is never stored here. NO ROW for a role = fall back to the
/// built-in defaults in lib/rbac.ts. `capabilities` is a JSON string[] of granted
/// capability keys. Edited only from /hierarchy by a crm_admin; the effective matrix is
/// cached in-process and rebuilt on save (see lib/permissions.ts).
model RolePermission {
  id           String   @id @default(cuid())
  role         String   @unique
  capabilities Json     @default("[]")
  updatedById  String? // User.id of the admin who last edited (no FK, like AuditLog.actorId)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Treatment catalog (§quote generation) — the clinic's Master Data List of bookable
/// Services and Packages. A quote's treatment is picked from here, auto-filling the
/// price and GST. Seeded/refreshed from the master spreadsheet via scripts/importCatalog.ts
/// (upsert by type+name), so re-importing a new version updates prices in place.
///   type      : "service" | "package"
///   price     : base price in whole rupees — the service price, or for a package the
///               STANDARD (pre-discount) price, so the quote shows the saving.
///   gstRate   : 5 (2.5 CGST + 2.5 SGST) or 0 (items marked "NA" in the master list).
///   defaultDiscountValue : a package's built-in discount % (percent), else null.
///   packagePrice : the package's already-discounted price (reference; packages only).
model CatalogItem {
  id                   String  @id @default(cuid())
  type                 String
  category             String
  code                 String?
  name                 String
  price                Int
  gstRate              Float   @default(5)
  defaultDiscountType  String? // "percent" for packages with a built-in discount, else null
  defaultDiscountValue Float? // the package discount % (per defaultDiscountType)
  packagePrice         Int? // packages only: the discounted package price, for reference
  active               Boolean @default(true)
  sortOrder            Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, name])
  @@index([active])
  @@index([category])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// A WhatsApp chatbot flow (Phase 2 — chatbot builder). A visual node graph that
/// runs against inbound WhatsApp messages: on a matching trigger, the runtime walks
/// the nodes (send messages, ask questions, branch, assign) node-by-node. The graph
/// itself is stored as JSON (React Flow nodes + edges); see lib/chatbotFlows.ts.
model ChatbotFlow {
  id            String    @id @default(cuid())
  name          String
  // What starts the flow: inbound_message | template_message | … (TRIGGER_EVENTS).
  triggerEvent  String    @default("inbound_message")
  // Optional trigger match config (e.g. { field: "message_text", op: "not_equals", value: "XYZ" }).
  triggerConfig Json?
  priority      String    @default("high") // high | medium | low
  active        Boolean   @default(false)
  expireOn      DateTime? // null = never expires
  // The flow definition: { nodes: [...], edges: [...] } (React Flow shape).
  graph         Json      @default("{\"nodes\":[],\"edges\":[]}")

  // Branch scaffold (per-branch flows later) + who created it.
  branchId    String?
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions ChatbotSession[]

  @@index([active])
  @@index([triggerEvent])
}

/// A running chatbot conversation (Phase 3 — runtime). One active session per lead:
/// when the flow hits a wait node (ask / buttons / list) it pauses here with the
/// node id, and the lead's next inbound message resumes it. `variables` holds the
/// answers collected so far (used for {{placeholder}} interpolation + branching).
model ChatbotSession {
  id            String      @id @default(cuid())
  leadId        String
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  flowId        String
  flow          ChatbotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  status        String      @default("active") // active (waiting for a reply) | ended
  currentNodeId String? // the wait node we're paused at
  waitKind      String? // ask | buttons | list — how to read the next reply
  variables     Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([leadId, status])
  @@index([flowId])
}

// ── Phase 2 foundations ──────────────────────────────────────────────

/// A clinic branch (§branches). A CRM Admin creates one per physical clinic (e.g.
/// Santacruz, Juhu). It carries everything a quote/invoice needs to render for THAT
/// location — legal entity + GSTIN, address, bank + UPI/QR — so a quote raised at a
/// branch shows the branch's own details. `isDefault` is the fallback used when a
/// user/quote has no branch yet (keeps single-branch behaviour working). Lead routing
/// by branch is not wired yet (round-robin is still global — see lib/salesReps.ts).
model Branch {
  id        String  @id @default(cuid())
  code      String  @unique // short code, e.g. "SCZ", "JUH" — used in quote refs
  name      String // display name, e.g. "Cara Santacruz"
  active    Boolean @default(true)
  isDefault Boolean @default(false) // the fallback branch (exactly one should be true)

  // Legal / tax identity (per branch — each may invoice under its own GSTIN).
  legalName String? // registered entity, e.g. "Cara Healthcare Private Limited"
  gstin     String?

  // Location + contact (rendered on quotes; also the walk-in clinic address).
  addressLine1 String?
  addressLine2 String?
  city         String?
  pincode      String?
  phone        String?
  email        String?

  // Payment details for quotes/invoices (the "pay to" block on the quote PDF).
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String? // bank + branch, e.g. "ICICI Bank, Santacruz West"
  upiId             String?
  qrImage           Bytes? // Razorpay/UPI QR PNG bytes (stored here so it survives redeploys)

  // Branch manager (a staff login). SetNull so deleting the user doesn't drop the branch.
  managerId String?
  manager   User?   @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)

  // ── Follow-up quiet hours (Phase 2 §follow-up) — automated campaign messages are
  //    NEVER sent inside this IST window (default 20:00–09:00). Stored as wall-clock
  //    hours [0-23]; null = use the global default. Distinct from the call DND window
  //    (lib/callWindow.ts), which governs AI voice calls, not campaign messages. ──
  quietStartHour Int? // IST hour the quiet window opens (default 20 = 8 PM)
  quietEndHour   Int? // IST hour the quiet window closes (default 9 = 9 AM)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  leads            Lead[]
  reps             SalesRep[]
  users            User[]            @relation("UserHomeBranch")
  quotes           Quote[]           @relation("QuoteBranch")
  invoicedQuotes   Quote[]           @relation("QuoteInvoicedBranch")
  invoicesRaised   Invoice[]         @relation("InvoiceBranch")
  creditDisputesRaised   QuoteCreditDispute[] @relation("DisputeClaimant")
  creditDisputesAgainst  QuoteCreditDispute[] @relation("DisputeCredited")
  chatbotFlows     ChatbotFlow[]
  campaignSettings CampaignSetting[]
  postSalesJourneys PostSalesJourney[] @relation("JourneyBranch")

  @@index([active])
}

/// A lead's membership in a follow-up campaign (Phase 2 §follow-up). THE core guardrail:
/// a lead may hold AT MOST ONE active enrollment at a time — enforced by a partial unique
/// index on (leadId) WHERE status = 'active' (added in the migration). Campaigns follow the
/// PERSON, never the quote — two open quotes still yield one enrollment. `drivingQuoteId`
/// records which quote's value/urgency selected the campaign, for context only.
model CampaignEnrollment {
  id           String @id @default(cuid())
  leadId       String
  lead         Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// couldnt_reach | worried_cost | just_researching | hot_lead | international | win_back | dead_lead_bulk
  campaignType String
  /// active | stopped | completed
  status       String @default("active")
  /// 0-based index of the NEXT step to send in the campaign's schedule.
  step         Int    @default(0)

  // Branch snapshot at enrollment — drives the per-branch on/off toggle + quiet hours
  // lookup even if the lead's branch later changes.
  branchId       String?
  // The quote (if any) whose higher value/urgency selected this campaign — context only.
  drivingQuoteId String?

  nextRunAt    DateTime? // when the next step is due (null once completed/stopped)
  lastSentAt   DateTime?
  messagesSent Int       @default(0)

  startedAt  DateTime  @default(now())
  stoppedAt  DateTime?
  /// replied | opted_out | excluded | superseded | completed | manual — why it ended.
  stopReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextRunAt])
  @@index([leadId])
  @@index([campaignType])
}

/// Per-branch on/off switch for each follow-up campaign type (Phase 2 §follow-up).
/// Absence of a row = enabled (opt-out model); a row with enabled=false suppresses that
/// campaign for that branch. Hard exclusions and the global kill-switch override this.
model CampaignSetting {
  id           String  @id @default(cuid())
  branchId     String
  branch       Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  campaignType String
  enabled      Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([branchId, campaignType])
  @@index([branchId])
}

/// A treatment quote (Phase 2 §multi-quote). THE structural change: a lead is the
/// person, a quote is the treatment. One lead holds many quotes; each converts on
/// its own with its own price, status, post-sales journey, and invoice. The lead
/// never "converts" — it summarises its quotes. A repeat request for the same
/// treatment is a NEW quote (new `cycle`), never a reopened old one.
model Quote {
  id        String @id @default(cuid())
  leadId    String
  lead      Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  treatment String // e.g. "Hair transplant (FUE)", "PRP"

  // Quote lifecycle — independent of the lead's person-track stage.
  // drafted | sent | viewed | accepted | awaiting_payment | converted |
  // in_treatment | completed | rejected | expired | replaced | withdrawn
  status       String  @default("drafted")

  // Cycle: 1 = first time we've quoted this person for this treatment, 2 = repeat, …
  cycle Int @default(1)

  price    Int? // BASE treatment price, whole rupees (no card/bank data here)
  currency String @default("INR")

  // ── Pricing breakdown (§multi-quote) — the DISCOUNT comes off the base FIRST, then
  //    GST is charged on the discounted amount. GST is fixed at 5% (2.5% CGST + 2.5%
  //    SGST) for now but stored per quote so historical quotes keep their rate.
  //    Discount is either a percentage (of the base) or a flat rupee amount.
  //    `totalPayable` is the auto-computed final = (base − discount) + GST.
  //    computeQuoteTotals() in lib/quoteStages.ts is the single implementation. ──
  gstRate       Float   @default(5) // total GST % (CGST + SGST)
  discountType  String? // "percent" | "inr" | null
  discountValue Float? // percent (e.g. 12.5) or rupee amount, per discountType
  totalPayable  Int? // computed final amount in whole rupees

  rejectionReason String? // mandatory (from QUOTE_REJECTION_REASONS) when status=rejected
  // §multi-quote: "no quote is ever deleted — withdrawn quotes stay, with a reason
  // and a name against them." Withdrawal reason is free-text; `closedById` is the
  // user who rejected OR withdrew this quote (the name against it).
  withdrawnReason String?
  closedById      String?
  // What brought THIS quote about (attribution stops at the door they came through):
  // ad | asked_during_consultation | post_op_upsell | existing_patient_repeat
  source          String?
  expiresAt       DateTime? // default 30 days from send; nudge 48h before

  // The branch this quote was raised at (§branches) — set at creation from the
  // creating user's home branch (→ default branch). Drives which legal entity / GSTIN
  // / bank / address the quote PDF renders. Distinct from invoicedBranchId (billing).
  branchId String?
  branch   Branch? @relation("QuoteBranch", fields: [branchId], references: [id], onDelete: SetNull)

  // Populated by the billing system — never typed. "Converted" means a real invoice
  // exists for THIS quote; the invoicing branch earns the credit.
  invoicedBranchId String?
  invoicedBranch   Branch? @relation("QuoteInvoicedBranch", fields: [invoicedBranchId], references: [id], onDelete: SetNull)

  // Counsellor who owns THIS quote (may differ from the lead's owner).
  ownerRepId String?
  ownerRep   SalesRep? @relation("QuoteOwner", fields: [ownerRepId], references: [id], onDelete: SetNull)

  // On conversion the QUOTE locks (read-only) — never the lead, which stays active
  // for the person's other open quotes. Only an Admin unlocks, with a logged reason.
  lockedAt    DateTime?
  convertedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions QuoteVersion[]
  /// Invoices raised against THIS quote (§billing). Its existence is what makes the
  /// quote "converted"; the invoicing branch earns the credit.
  invoices Invoice[]
  /// The one credit dispute this quote may carry (§branch credit).
  creditDispute QuoteCreditDispute?
  // The post-sales journey this quote opened on conversion (§post-sales) — at most
  // one per quote. Two converted treatments = two journeys, running independently.
  journey  PostSalesJourney?

  @@index([leadId])
  @@index([status])
  @@index([ownerRepId])
  @@index([branchId])
  @@index([invoicedBranchId])
}

/// Price-version history for a Quote (§multi-quote). Revising a price REPLACES the
/// current version (kept, marked replaced) rather than creating a new quote — so the
/// full price trail survives. No quote or version is ever deleted.
model QuoteVersion {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  price       Int
  note        String?
  replaced    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([quoteId, createdAt])
}

// ── Post-sales ERP (§post-sales) ─────────────────────────────────────
// The clinical side of the house: doctors, the OT team, post-sales consultants and
// the front desk work here, NOT in the sales pipeline. The unit of work is the
// converted QUOTE, never the lead — a patient who converts a hair transplant and a
// PRP course has TWO journeys, running at their own speeds, and sees ONE
// coordinated stream of messages.

/// One post-sales journey per CONVERTED quote (§post-sales). Opened automatically
/// the moment a quote reaches `converted` (an invoice exists) and never before.
/// `stage` is the clinical track — entirely separate from Quote.status (commercial)
/// and Lead.stage (the person's sales track). Only the post-sales team may move it;
/// sales counsellors have read-only sight of it (capability `postsales.manage`).
///
/// The stage clock: `stageDueAt` is computed on every stage move from the treatment's
/// TreatmentStagePolicy — hair-transplant recovery is not PRP recovery. Past it, the
/// journey is OVERDUE and the sweep alerts the accountable staff once per stall
/// (`overdueNotifiedAt`, reset on each move).
model PostSalesJourney {
  id      String @id @default(cuid())
  /// The converted quote this journey belongs to. UNIQUE — one journey per quote.
  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  /// Denormalised from the quote so patient-level queries (the one-message-per-day
  /// check-in coordination, "all journeys for this patient") don't need a join.
  leadId  String
  lead    Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// converted | pre_op | surgery_done | post_op_followup | recovery_monitoring |
  /// closed_successfully. Keys in lib/postSales/stages.ts.
  stage             String    @default("converted")
  stageChangedAt    DateTime  @default(now())
  /// When the CURRENT stage breaches its time limit (from the treatment policy).
  /// Null = this stage has no limit (e.g. the terminal stage).
  stageDueAt        DateTime?
  /// Dedups the overdue alert per stall — cleared on every stage move.
  overdueNotifiedAt DateTime?

  /// Resolved policy key for this treatment (e.g. "hair_transplant", "prp",
  /// "default") — snapshotted so a later policy rename can't silently re-time a
  /// journey already in flight. See lib/postSales/policy.ts.
  treatmentType String @default("default")

  // ── The clinical team on this journey. Staff LOGINS, so the accountable person
  //    can act on their own stage. SetNull so removing a login keeps the journey. ──
  doctorId     String?
  doctor       User?   @relation("JourneyDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  otLeadId     String?
  otLead       User?   @relation("JourneyOtLead", fields: [otLeadId], references: [id], onDelete: SetNull)
  consultantId String?
  consultant   User?   @relation("JourneyConsultant", fields: [consultantId], references: [id], onDelete: SetNull)

  /// When surgery actually happened. Set on the move to `surgery_done` and it is
  /// the ANCHOR for the whole check-in schedule (day 1 / 7 / 30 / 90 after this).
  surgeryAt DateTime?
  /// Set once the check-in rows have been generated for `surgeryAt`, so re-entering
  /// the stage doesn't duplicate them. Cleared when the surgery date is corrected.
  checkInsScheduledAt DateTime?

  /// Branch snapshot at handover — the branch that INVOICED where known (that branch
  /// earned the credit), else the branch the quote was raised at.
  branchId String?
  branch   Branch? @relation("JourneyBranch", fields: [branchId], references: [id], onDelete: SetNull)

  /// The handover summary generated at conversion (§post-sales "Handing Over Cleanly")
  /// — name, procedure, price, invoicing branch, notes, language, comms preferences,
  /// safety flags, other open quotes. A SNAPSHOT of what was handed over, kept for the
  /// record; the journey page renders the volatile parts (flags, open quotes) live.
  /// Never contains call recordings or transcripts — post-sales sees the summary only.
  handoverSummary     Json?
  handoverGeneratedAt DateTime?

  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  closedNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns PostSalesCheckIn[]
  notes    PostSalesNote[]

  @@index([stage])
  @@index([stageDueAt])
  @@index([leadId])
  @@index([branchId])
  @@index([consultantId])
  @@index([doctorId])
  @@index([otLeadId])
}

/// A scheduled post-surgery clinical check-in (§post-sales: day 1, 7, 30, 90 after
/// each surgery, over WhatsApp). Rows are generated when a journey reaches
/// `surgery_done`; the worker tick sends whatever is due.
///
/// These are MEDICAL CARE messages, not marketing: they are governed by clinical
/// consent and go out even to a patient who opted out of promotions, and they do not
/// count against the marketing 12-in-30 ceiling.
///
/// COORDINATION (§post-sales "the patient sees one relationship, not two"): at most
/// ONE check-in per PATIENT per day across every journey they have running. When two
/// journeys land a check-in on the same morning the clinically closer one (smaller
/// dayOffset) goes and the other is pushed a day, recording `deferredReason`.
model PostSalesCheckIn {
  id        String           @id @default(cuid())
  journeyId String
  journey   PostSalesJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  /// Denormalised for the one-per-patient-per-day coordination query.
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Days after surgery this check-in is for: 1 | 7 | 30 | 90 (per-treatment override
  /// possible via TreatmentStagePolicy.checkInDays).
  dayOffset Int
  /// When it should go out (may be pushed by coordination / quiet hours).
  scheduledFor DateTime
  /// The un-nudged surgeryAt + dayOffset, so the UI can show that it was moved.
  originalFor  DateTime

  /// pending — due to send · sent — delivered to WhatsApp · done_manually — a human
  /// checked in instead · skipped — deliberately not sent · blocked — cannot be
  /// automated (no template, safety flag, no clinical consent): needs a person ·
  /// failed — send errored after retries.
  status String @default("pending")

  sentAt        DateTime?
  /// The Message row this produced, so the check-in links into the patient's thread.
  messageId     String?
  attempts      Int       @default(0)
  lastError     String?
  /// Why it can't be automated (status=blocked) — shown to the consultant as a task.
  blockedReason String?
  /// Why the date moved (coordination clash / quiet hours), for the UI + audit.
  deferredReason String?
  /// How many times it has been pushed — a safety valve so a clash can't push forever.
  deferrals      Int      @default(0)

  /// Who marked it done/skipped by hand (User.id), mirroring the audit convention.
  completedById String?
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One check-in per day-offset per journey — makes generation idempotent.
  @@unique([journeyId, dayOffset])
  @@index([status, scheduledFor])
  @@index([leadId, scheduledFor])
  @@index([journeyId])
}

/// A clinical / operational note on a post-sales journey (§post-sales). Journey-scoped
/// rather than lead-scoped so a note about the hair transplant doesn't surface on the
/// PRP journey. Mirrors LeadComment's conventions: human-authored, author name
/// snapshotted so attribution survives the login being removed, deletable by the
/// author or a manager (unlike the immutable AuditLog).
model PostSalesNote {
  id         String           @id @default(cuid())
  journeyId  String
  journey    PostSalesJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String?
  /// clinical (medical observation) | admin (logistics, scheduling, billing chase)
  kind       String           @default("clinical")
  body       String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([journeyId, createdAt])
}

/// Per-treatment-type post-sales timings (§post-sales: "Time limits per stage, per
/// treatment type. Hair transplant recovery is not PRP recovery. Overdue = alert.").
///
/// `stageDays` is a JSON map of journey-stage key → allowed days in that stage, e.g.
/// `{"converted":3,"pre_op":14,"surgery_done":2,"post_op_followup":30,"recovery_monitoring":120}`.
/// A missing key means that stage has no limit. `checkInDays` overrides the standard
/// [1,7,30,90] schedule for this treatment. Exactly one row should carry
/// `isDefault` — it is the fallback for any treatment with no policy of its own.
/// Absence of ALL rows falls back to the code defaults in lib/postSales/policy.ts.
model TreatmentStagePolicy {
  id            String  @id @default(cuid())
  /// Stable policy key, e.g. "hair_transplant" | "prp" | "default".
  treatmentType String  @unique
  label         String
  stageDays     Json    @default("{}")
  checkInDays   Int[]   @default([1, 7, 30, 90])
  active        Boolean @default(true)
  isDefault     Boolean @default(false)

  updatedById String? // User.id of the admin who last edited (no FK, like AuditLog.actorId)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

/// Append-only audit trail (Phase 2 §audit). Every mutation, consent change,
/// reassignment, export, login, and record view writes one row here. Rows are never
/// updated or deleted by application code; `prevHash`/`hash` form a chain so a gap
/// or edit is detectable. True WORM immutability (if compliance demands it) is a
/// storage-layer concern layered on top of this.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String? // User.id (null for system/automation)
  actorEmail String?
  action     String // e.g. lead.field.update | lead.stage.move | consent.change | reassignment | export | login | login.failed | record.view | settings.change | toggle.change
  entityType String // lead | quote | user | setting | toggle | …
  entityId   String?
  field      String?
  oldValue   String?
  newValue   String?
  reason     String? // mandatory for some actions (toggle change, phone edit, flag clear)
  ip         String?
  meta       Json?
  prevHash   String? // hash of the previous row (tamper-evidence chain)
  hash       String? // hash of this row's canonical content

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([at])
  @@index([action])
}
