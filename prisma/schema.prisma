// Cara Clinic — Sales Automation Platform
// Database schema. See Tech Stack & Build Guide §6 (Key Tables).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A captured sales lead — the central source of truth (§6.1).
model Lead {
  id            String  @id @default(cuid())
  name          String
  phone         String // E.164 format for ElevenLabs to dial, e.g. +919876543210
  email         String?
  interest      String? // free-text clinic interest, e.g. "Hair treatment"
  source        String? // web_form | referral | manual | walk_in | facebook | instagram | google
  status        String  @default("new") // new | manual_followup | called | confirmed | rescheduled | unreachable | not_interested | lost
  interestLevel String? // high | medium | low — set by call outcome

  // ── Sales pipeline stage (human-facing, §3.1) — distinct from `status` (the
  //    internal automation state). Auto-advanced FORWARD-ONLY by call outcomes
  //    and editable by staff. Keys in lib/leadStages.ts. ──
  stage String  @default("ai_contacted") // ai_contacted | ai_attempted_unreachable | communication_not_established | human_callback_pending | in_consideration | appointment_scheduled | consultation_done | converted | lost
  // What the lead asked for in the call (e.g. "Hair transplant") — AI-filled from
  // the post-call write-back, staff-editable. Free text.
  tag   String?

  // ── Stage-age tracking (§3.1) — `stageChangedAt` is set whenever `stage` moves
  //    (auto-advance or manual), so the worker can flag a lead "stuck in stage"
  //    past the SLA and alert the counsellor. `stageStuckNotifiedAt` dedups that
  //    alert per stall; it's reset to null on every stage change. ──
  stageChangedAt       DateTime? @default(now())
  stageStuckNotifiedAt DateTime?

  // ── Lost (§3.1) — moving the stage to "lost" needs a preset `lostTag` and/or a
  //    free-text `lostReason` review. A tag makes the review optional; with no tag
  //    a written reason is required. Both cleared if the lead is reactivated. ──
  lostTag       String? // one of LOST_PRESET_TAGS (e.g. "pricing issue")
  lostReason    String? // free-text review (optional when a tag is set)
  lostAt        DateTime?
  // True when the lead was marked Lost BEFORE completing a consultation (a
  //    premature loss the counsellor was alerted to). Counted in the daily digest.
  prematureLost Boolean   @default(false)
  // ── Win-back (Phase 2 §follow-up) — when this lead was last auto-enrolled in the
  //    90-day Win-Back campaign. Dedups the daily sweep (one win-back per lost event:
  //    only re-enrol if the lead was lost AGAIN after the last win-back). ──
  lastWinBackAt DateTime?

  // ── AI→human handover (§3.1) — when an AI call hits a trigger (pricing/clinical
  //    question, distress, wants-human, competitor, unresolved objection, CQS≥75,
  //    unsupported language, hearing-impaired, abusive, wrong-person), the lead is
  //    routed to the sales team: AI drip stops, Slack alert fires, reason logged. ──
  needsHandover    Boolean   @default(false)
  handoverReason   String? // human-readable reason(s), shown to the counsellor
  handoverAt       DateTime?
  handoverTriggers String[] // machine keys of the triggers that fired

  // ── Assignment (§3.1) — the sales rep who OWNS this lead. Assigned round-robin
  //    at intake (every lead gets an owner for "my leads" scoping); a later
  //    handover notifies this existing owner rather than re-assigning. ──
  assignedRepId String?
  assignedRep   SalesRep? @relation("LeadAssignee", fields: [assignedRepId], references: [id], onDelete: SetNull)
  assignedAt    DateTime?

  // Which login created this lead (§3.1 RBAC) — used for Front-Desk "own leads"
  // scoping (they see what they entered). Null for AI/ad/web-intake leads.
  createdById String?

  // ── Branch (Phase 2) — nullable scaffold. One branch for now; every branch-scoped
  //    feature (routing, dashboards, attribution, toggles) hangs off this later. ──
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // ── Protection flags (Phase 2 §compliance) — persistent, call-BLOCKING flags,
  //    distinct from transient handoverTriggers. Any of these true = the "call"
  //    action is refused unless a manager overrides with a logged reason. A
  //    possible-minor / legal-threat / complaint also excludes the lead from ALL
  //    campaigns. Cleared only by a Branch Manager / Admin (audited). ──
  possibleMinor     Boolean @default(false)
  hearingImpaired   Boolean @default(false)
  legalThreatFreeze Boolean @default(false)
  complaintOpen     Boolean @default(false)
  protectionNote    String? // free-text context for whoever set/clears a flag

  // ── Per-channel consent (Phase 2 §consent) — consent is not one bit. Someone can
  //    allow a nurse's call but not marketing. Checked before EVERY message/call,
  //    alongside the hard `optedOut` suppression. Null = unknown (treat as no for
  //    marketing). `onDnd` caches the last Do-Not-Call registry lookup. ──
  consentCall      Boolean?
  consentMarketing Boolean?
  consentUpdatedAt DateTime?
  onDnd            Boolean   @default(false)
  dndCheckedAt     DateTime?

  // ── Opt-out / suppression (§3.1.10) — hard flag: once true, NO outreach (calls,
  //    retries, callbacks) is allowed. Set on "not interested" or WhatsApp STOP. ──
  optedOut       Boolean   @default(false)
  optedOutAt     DateTime?
  optedOutReason String?

  // ── Held for review (§3.1) — anti-spam: a burst of submissions from one IP
  //    (>5 in 10 min) captures the lead but flags it for a human to vet before
  //    any AI call fires. Held leads sit in the manual_followup queue. ──
  heldForReview Boolean   @default(false)
  heldAt        DateTime?
  heldReason    String?

  // ── Consent capture (§3.1.13) — for walk-in/front-desk, the iPad/written
  //    consent form is collected at the clinic BEFORE the record is created. ──
  consentMethod String? // ipad | written (null for digital sources that consent differently)
  consentAt     DateTime? // when consent was captured
  consentBy     String? // staff member (email) who captured the consent

  // ── Callback requested by the lead during a call (§3.1.2) ──
  callbackAt DateTime? // specific time the lead asked to be called back

  // ── Duplicate detection (§3.1.1) — points to the pre-existing lead this one
  //    duplicates (matched on phone/email). Duplicates are not auto-called;
  //    they go to the manual queue for counsellor review/merge. ──
  duplicateOfId String?
  duplicateOf   Lead?   @relation("LeadDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Lead[]  @relation("LeadDuplicates")

  // ── Attribution (set by ad / form intake adapters) ──
  externalId String? // provider's lead id (Meta leadgen_id, Google lead_id) — dedup key
  campaign   String? // campaign id/name
  adId       String? // ad / adgroup / creative id

  // ── Soft delete / trash (§3.1) — a staff-removed lead. When set it's excluded
  //    from lists, metrics, dedup, and calling; it shows in the Deleted section,
  //    where it can be restored (deletedAt→null) or permanently removed. ──
  deletedAt DateTime?
  deletedBy String? // staff email who moved it to trash

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls               Call[]
  messages            Message[]
  quotes              Quote[]
  chatbotSessions     ChatbotSession[]
  accessGrants        LeadAccessGrant[]
  campaignEnrollments CampaignEnrollment[]

  @@index([status])
  @@index([phone])
  @@index([source])
  @@index([externalId])
  @@index([duplicateOfId])
  @@index([heldForReview])
  @@index([stage])
  @@index([stageChangedAt])
  @@index([needsHandover])
  @@index([assignedRepId])
  @@index([deletedAt])
}

/// A sales rep / telecaller who receives AI→human handovers (§3.1). Handovers are
/// distributed round-robin (least-recently-assigned first). `slackUserId` enables
/// an individual Slack DM; `phone` is the click-to-call number.
model SalesRep {
  id             String    @id @default(cuid())
  name           String
  slackUserId    String? // Slack member id (e.g. U0123ABCD) for the individual DM
  phone          String // E.164, for click-to-call
  active         Boolean   @default(true)
  // Sales head (§3.1): a manager, NOT a line telecaller. Excluded from the
  // round-robin handover rota, and pinged ONLY on CQS extremes (very high /
  // very low) — the exceptional wins and the quality failures worth their time.
  salesHead      Boolean   @default(false)
  lastAssignedAt DateTime? // round-robin cursor
  createdAt      DateTime  @default(now())

  // ── Availability / presence (§presence "Knowing who's available") ──
  // Day-to-day presence, DISTINCT from `active` (the admin employment/enabled flag).
  // Only "available" reps enter the round-robin (pickNextRep); the rest have their
  // new leads routed to the next available counsellor.
  //   available | in_consultation | break | offline
  availability   String   @default("available")
  availabilityAt DateTime @default(now()) // when availability last changed
  // Heartbeat from the app — drives the 15-min auto-offline sweep (during work hours).
  lastActivityAt DateTime @default(now())
  // True while auto-set to in_consultation by a live click-to-call, so the call-end
  // webhook reverts to available (and a manual Break isn't clobbered by a stray revert).
  onCall         Boolean  @default(false)
  // Skill/speciality (§presence) — an offline counsellor's leads prefer a colleague
  // with the SAME speciality; null = generalist (eligible only as a fallback match).
  speciality     String?

  // Branch (Phase 2) — nullable scaffold; the rep's home branch for routing/scoping.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  leads        Lead[]  @relation("LeadAssignee")
  handledCalls Call[]  @relation("CallHandler")
  ownedQuotes  Quote[] @relation("QuoteOwner")
  user         User? // the login account linked to this rep (§3.1 RBAC)

  @@index([active, lastAssignedAt])
  // Fast lookup for the round-robin (available reps) and the idle-sweep.
  @@index([availability, salesHead, active])
  @@index([lastActivityAt])
}

/// A single WhatsApp message exchanged with a lead (§3.1.3). Both automated
/// (system/AI-sent) and manual (agent-sent) messages, plus every inbound reply,
/// are stored here so the lead profile shows ONE continuous thread on ONE number
/// — any agent can pick up where the last left off (continuity across turnover).
model Message {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel      String   @default("whatsapp") // whatsapp (room for sms/etc. later)
  direction    String // inbound | outbound
  waId         String?  @unique // Meta wamid — dedups inbound retries + links status updates
  type         String   @default("text") // text | template | image | document | audio | video | button | interactive
  body         String? // text/caption, or a short summary for non-text types
  mediaId      String? // Meta media id (download via Graph API — Phase 2)
  mediaUrl     String? // stored/resolved media URL once downloaded
  templateName String? // outbound template name (type=template)
  status       String? // outbound: queued|sent|delivered|read|failed ; inbound: received
  error        String? // failure detail (status=failed)
  automated    Boolean  @default(false) // true = system/AI-sent; false = manual agent / inbound
  sentBy       String? // agent email for manual outbound; null for inbound/automated
  createdAt    DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([status])
}

/// A single AI voice call placed against a Lead (§6.2).
model Call {
  id           String  @id @default(cuid())
  leadId       String
  lead         Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  callType     String // initial | reconfirmation | human_handover
  transcript   String?
  outcome      String? // confirmed | no_answer | rescheduled | not_interested
  sentiment    String? // positive | neutral | negative
  duration     Int? // seconds
  // Provider correlation ids are UNIQUE so a retried/duplicate webhook (ElevenLabs
  // + n8n + Twilio all retry on timeout/5xx) can't create a second Call and
  // re-run the pipeline. NULLs are allowed and don't collide (Postgres).
  elevenlabsId String? @unique // ElevenLabs conversation/call id
  recordingUrl String? // Twilio recording URL for human-handover calls (§3.1)
  providerSid  String? @unique // Twilio CallSid (correlation)
  cqs          Int? // Conversation Quality Score 0–100, judged by Claude (§3.1)
  cqsBreakdown Json? // per-dimension scores + objection type + summary

  // Who handled a human-handover call — the rep who initiated the click-to-call
  // (from the Slack button or the in-app button). Null for AI calls. (§3.1)
  handledById String?
  handledBy   SalesRep? @relation("CallHandler", fields: [handledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([callType])
}

// ── Auth (NextAuth.js / Auth.js — §2.5) ──────────────────────────────

/// Application user (a login). `role` drives role-based access (§3.1 RBAC).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // RBAC role. See lib/rbac.ts for the capability map:
  //   front_desk | telecaller | branch_manager | sales_head | crm_admin
  role          String    @default("telecaller")
  passwordHash  String? // for credentials login (optional)

  // Link this login to a sales-rep identity (§3.1) — so "my leads" scoping and
  // handover/click-to-call attribution resolve to the person. Telecallers (and
  // anyone who can be assigned leads) have one; pure admins may not.
  salesRepId String?   @unique
  salesRep   SalesRep? @relation(fields: [salesRepId], references: [id], onDelete: SetNull)

  // Home branch (§branches) — the login's clinic; a quote they raise inherits it.
  branchId String?
  branch   Branch? @relation("UserHomeBranch", fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  // Branches this user manages (Branch.managerId points here).
  managedBranches Branch[] @relation("BranchManager")

  // Temporary lead-access grants received (§handover — cover a colleague's lead).
  leadGrants LeadAccessGrant[] @relation("LeadGrantee")
}

/// A temporary grant of access to a lead (§handover) — lets a counsellor act on a
/// colleague's lead WITHOUT changing ownership (e.g. cover while the owner is on leave).
/// A manager/admin grants it with a reason and an optional expiry; it can be revoked
/// early. An "active" grant (revokedAt null and not past expiry) widens the grantee's
/// lead scope (see lib/authz.ts). Every grant + revoke is written to AuditLog.
model LeadAccessGrant {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  granteeId   String // User.id granted access
  grantee     User      @relation("LeadGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  grantedById String? // User.id who granted (manager/admin)
  reason      String?
  expiresAt   DateTime? // null = until revoked
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([granteeId])
  @@index([revokedAt])
}

/// Admin-editable role → capability overrides (§3.1 Hierarchy settings). One row per
/// editable role (front_desk | telecaller | branch_manager | sales_head). crm_admin is
/// always all-access and is never stored here. NO ROW for a role = fall back to the
/// built-in defaults in lib/rbac.ts. `capabilities` is a JSON string[] of granted
/// capability keys. Edited only from /hierarchy by a crm_admin; the effective matrix is
/// cached in-process and rebuilt on save (see lib/permissions.ts).
model RolePermission {
  id           String   @id @default(cuid())
  role         String   @unique
  capabilities Json     @default("[]")
  updatedById  String? // User.id of the admin who last edited (no FK, like AuditLog.actorId)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Treatment catalog (§quote generation) — the clinic's Master Data List of bookable
/// Services and Packages. A quote's treatment is picked from here, auto-filling the
/// price and GST. Seeded/refreshed from the master spreadsheet via scripts/importCatalog.ts
/// (upsert by type+name), so re-importing a new version updates prices in place.
///   type      : "service" | "package"
///   price     : base price in whole rupees — the service price, or for a package the
///               STANDARD (pre-discount) price, so the quote shows the saving.
///   gstRate   : 5 (2.5 CGST + 2.5 SGST) or 0 (items marked "NA" in the master list).
///   defaultDiscountValue : a package's built-in discount % (percent), else null.
///   packagePrice : the package's already-discounted price (reference; packages only).
model CatalogItem {
  id                   String  @id @default(cuid())
  type                 String
  category             String
  code                 String?
  name                 String
  price                Int
  gstRate              Float   @default(5)
  defaultDiscountType  String? // "percent" for packages with a built-in discount, else null
  defaultDiscountValue Float? // the package discount % (per defaultDiscountType)
  packagePrice         Int? // packages only: the discounted package price, for reference
  active               Boolean @default(true)
  sortOrder            Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, name])
  @@index([active])
  @@index([category])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// A WhatsApp chatbot flow (Phase 2 — chatbot builder). A visual node graph that
/// runs against inbound WhatsApp messages: on a matching trigger, the runtime walks
/// the nodes (send messages, ask questions, branch, assign) node-by-node. The graph
/// itself is stored as JSON (React Flow nodes + edges); see lib/chatbotFlows.ts.
model ChatbotFlow {
  id            String    @id @default(cuid())
  name          String
  // What starts the flow: inbound_message | template_message | … (TRIGGER_EVENTS).
  triggerEvent  String    @default("inbound_message")
  // Optional trigger match config (e.g. { field: "message_text", op: "not_equals", value: "XYZ" }).
  triggerConfig Json?
  priority      String    @default("high") // high | medium | low
  active        Boolean   @default(false)
  expireOn      DateTime? // null = never expires
  // The flow definition: { nodes: [...], edges: [...] } (React Flow shape).
  graph         Json      @default("{\"nodes\":[],\"edges\":[]}")

  // Branch scaffold (per-branch flows later) + who created it.
  branchId    String?
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions ChatbotSession[]

  @@index([active])
  @@index([triggerEvent])
}

/// A running chatbot conversation (Phase 3 — runtime). One active session per lead:
/// when the flow hits a wait node (ask / buttons / list) it pauses here with the
/// node id, and the lead's next inbound message resumes it. `variables` holds the
/// answers collected so far (used for {{placeholder}} interpolation + branching).
model ChatbotSession {
  id            String      @id @default(cuid())
  leadId        String
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  flowId        String
  flow          ChatbotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  status        String      @default("active") // active (waiting for a reply) | ended
  currentNodeId String? // the wait node we're paused at
  waitKind      String? // ask | buttons | list — how to read the next reply
  variables     Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([leadId, status])
  @@index([flowId])
}

// ── Phase 2 foundations ──────────────────────────────────────────────

/// A clinic branch (§branches). A CRM Admin creates one per physical clinic (e.g.
/// Santacruz, Juhu). It carries everything a quote/invoice needs to render for THAT
/// location — legal entity + GSTIN, address, bank + UPI/QR — so a quote raised at a
/// branch shows the branch's own details. `isDefault` is the fallback used when a
/// user/quote has no branch yet (keeps single-branch behaviour working). Lead routing
/// by branch is not wired yet (round-robin is still global — see lib/salesReps.ts).
model Branch {
  id        String  @id @default(cuid())
  code      String  @unique // short code, e.g. "SCZ", "JUH" — used in quote refs
  name      String // display name, e.g. "Cara Santacruz"
  active    Boolean @default(true)
  isDefault Boolean @default(false) // the fallback branch (exactly one should be true)

  // Legal / tax identity (per branch — each may invoice under its own GSTIN).
  legalName String? // registered entity, e.g. "Cara Healthcare Private Limited"
  gstin     String?

  // Location + contact (rendered on quotes; also the walk-in clinic address).
  addressLine1 String?
  addressLine2 String?
  city         String?
  pincode      String?
  phone        String?
  email        String?

  // Payment details for quotes/invoices (the "pay to" block on the quote PDF).
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String? // bank + branch, e.g. "ICICI Bank, Santacruz West"
  upiId             String?
  qrImage           Bytes? // Razorpay/UPI QR PNG bytes (stored here so it survives redeploys)

  // Branch manager (a staff login). SetNull so deleting the user doesn't drop the branch.
  managerId String?
  manager   User?   @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)

  // ── Follow-up quiet hours (Phase 2 §follow-up) — automated campaign messages are
  //    NEVER sent inside this IST window (default 20:00–09:00). Stored as wall-clock
  //    hours [0-23]; null = use the global default. Distinct from the call DND window
  //    (lib/callWindow.ts), which governs AI voice calls, not campaign messages. ──
  quietStartHour Int? // IST hour the quiet window opens (default 20 = 8 PM)
  quietEndHour   Int? // IST hour the quiet window closes (default 9 = 9 AM)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  leads            Lead[]
  reps             SalesRep[]
  users            User[]            @relation("UserHomeBranch")
  quotes           Quote[]           @relation("QuoteBranch")
  invoicedQuotes   Quote[]           @relation("QuoteInvoicedBranch")
  chatbotFlows     ChatbotFlow[]
  campaignSettings CampaignSetting[]

  @@index([active])
}

/// A lead's membership in a follow-up campaign (Phase 2 §follow-up). THE core guardrail:
/// a lead may hold AT MOST ONE active enrollment at a time — enforced by a partial unique
/// index on (leadId) WHERE status = 'active' (added in the migration). Campaigns follow the
/// PERSON, never the quote — two open quotes still yield one enrollment. `drivingQuoteId`
/// records which quote's value/urgency selected the campaign, for context only.
model CampaignEnrollment {
  id           String @id @default(cuid())
  leadId       String
  lead         Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// couldnt_reach | worried_cost | just_researching | hot_lead | international | win_back | dead_lead_bulk
  campaignType String
  /// active | stopped | completed
  status       String @default("active")
  /// 0-based index of the NEXT step to send in the campaign's schedule.
  step         Int    @default(0)

  // Branch snapshot at enrollment — drives the per-branch on/off toggle + quiet hours
  // lookup even if the lead's branch later changes.
  branchId       String?
  // The quote (if any) whose higher value/urgency selected this campaign — context only.
  drivingQuoteId String?

  nextRunAt    DateTime? // when the next step is due (null once completed/stopped)
  lastSentAt   DateTime?
  messagesSent Int       @default(0)

  startedAt  DateTime  @default(now())
  stoppedAt  DateTime?
  /// replied | opted_out | excluded | superseded | completed | manual — why it ended.
  stopReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextRunAt])
  @@index([leadId])
  @@index([campaignType])
}

/// Per-branch on/off switch for each follow-up campaign type (Phase 2 §follow-up).
/// Absence of a row = enabled (opt-out model); a row with enabled=false suppresses that
/// campaign for that branch. Hard exclusions and the global kill-switch override this.
model CampaignSetting {
  id           String  @id @default(cuid())
  branchId     String
  branch       Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  campaignType String
  enabled      Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([branchId, campaignType])
  @@index([branchId])
}

/// A treatment quote (Phase 2 §multi-quote). THE structural change: a lead is the
/// person, a quote is the treatment. One lead holds many quotes; each converts on
/// its own with its own price, status, post-sales journey, and invoice. The lead
/// never "converts" — it summarises its quotes. A repeat request for the same
/// treatment is a NEW quote (new `cycle`), never a reopened old one.
model Quote {
  id        String @id @default(cuid())
  leadId    String
  lead      Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  treatment String // e.g. "Hair transplant (FUE)", "PRP"

  // Quote lifecycle — independent of the lead's person-track stage.
  // drafted | sent | viewed | accepted | awaiting_payment | converted |
  // in_treatment | completed | rejected | expired | replaced | withdrawn
  status       String  @default("drafted")
  // Post-sales journey once converted (§post-sales): pre_op | surgery_done |
  // post_op_followup | recovery_monitoring | closed_successfully. Null pre-conversion.
  journeyStage String?

  // Cycle: 1 = first time we've quoted this person for this treatment, 2 = repeat, …
  cycle Int @default(1)

  price    Int? // BASE treatment price, whole rupees (no card/bank data here)
  currency String @default("INR")

  // ── Pricing breakdown (§multi-quote) — GST is applied to the base FIRST, then the
  //    discount. GST is fixed at 5% (2.5% CGST + 2.5% SGST) for now but stored per
  //    quote so historical quotes keep their rate. Discount is either a percentage
  //    (of the GST-inclusive subtotal) or a flat rupee amount. `totalPayable` is the
  //    auto-computed final amount = base + GST − discount. See lib/quoteStages.ts. ──
  gstRate       Float   @default(5) // total GST % (CGST + SGST)
  discountType  String? // "percent" | "inr" | null
  discountValue Float? // percent (e.g. 12.5) or rupee amount, per discountType
  totalPayable  Int? // computed final amount in whole rupees

  rejectionReason String? // mandatory (from QUOTE_REJECTION_REASONS) when status=rejected
  // §multi-quote: "no quote is ever deleted — withdrawn quotes stay, with a reason
  // and a name against them." Withdrawal reason is free-text; `closedById` is the
  // user who rejected OR withdrew this quote (the name against it).
  withdrawnReason String?
  closedById      String?
  // What brought THIS quote about (attribution stops at the door they came through):
  // ad | asked_during_consultation | post_op_upsell | existing_patient_repeat
  source          String?
  expiresAt       DateTime? // default 30 days from send; nudge 48h before

  // The branch this quote was raised at (§branches) — set at creation from the
  // creating user's home branch (→ default branch). Drives which legal entity / GSTIN
  // / bank / address the quote PDF renders. Distinct from invoicedBranchId (billing).
  branchId String?
  branch   Branch? @relation("QuoteBranch", fields: [branchId], references: [id], onDelete: SetNull)

  // Populated by the billing system — never typed. "Converted" means a real invoice
  // exists for THIS quote; the invoicing branch earns the credit.
  invoicedBranchId String?
  invoicedBranch   Branch? @relation("QuoteInvoicedBranch", fields: [invoicedBranchId], references: [id], onDelete: SetNull)

  // Counsellor who owns THIS quote (may differ from the lead's owner).
  ownerRepId String?
  ownerRep   SalesRep? @relation("QuoteOwner", fields: [ownerRepId], references: [id], onDelete: SetNull)

  // On conversion the QUOTE locks (read-only) — never the lead, which stays active
  // for the person's other open quotes. Only an Admin unlocks, with a logged reason.
  lockedAt    DateTime?
  convertedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions QuoteVersion[]

  @@index([leadId])
  @@index([status])
  @@index([ownerRepId])
  @@index([branchId])
  @@index([invoicedBranchId])
}

/// Price-version history for a Quote (§multi-quote). Revising a price REPLACES the
/// current version (kept, marked replaced) rather than creating a new quote — so the
/// full price trail survives. No quote or version is ever deleted.
model QuoteVersion {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  price       Int
  note        String?
  replaced    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([quoteId, createdAt])
}

/// Append-only audit trail (Phase 2 §audit). Every mutation, consent change,
/// reassignment, export, login, and record view writes one row here. Rows are never
/// updated or deleted by application code; `prevHash`/`hash` form a chain so a gap
/// or edit is detectable. True WORM immutability (if compliance demands it) is a
/// storage-layer concern layered on top of this.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String? // User.id (null for system/automation)
  actorEmail String?
  action     String // e.g. lead.field.update | lead.stage.move | consent.change | reassignment | export | login | login.failed | record.view | settings.change | toggle.change
  entityType String // lead | quote | user | setting | toggle | …
  entityId   String?
  field      String?
  oldValue   String?
  newValue   String?
  reason     String? // mandatory for some actions (toggle change, phone edit, flag clear)
  ip         String?
  meta       Json?
  prevHash   String? // hash of the previous row (tamper-evidence chain)
  hash       String? // hash of this row's canonical content

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([at])
  @@index([action])
}
