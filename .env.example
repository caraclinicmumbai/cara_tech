# Cara Clinic — Sales Automation Platform
# Copy to .env.local and fill in. NEVER commit .env.local. (Guide §10)

# ── Database (PostgreSQL + Prisma) ──
DATABASE_URL="postgresql://user:password@localhost:5432/cara_clinic"

# ── Redis (BullMQ broker) ──
REDIS_URL="redis://localhost:6379"

# ── Auth (NextAuth.js / Auth.js v5) ──
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# ── n8n (self-hosted) ──
N8N_WEBHOOK_NEW_LEAD="https://your-n8n.com/webhook/new-lead"
N8N_API_KEY="your-n8n-api-key"

# ── ElevenLabs (Conversational AI — outbound calls + post-call webhook) ──
ELEVENLABS_API_KEY="your-elevenlabs-key"
ELEVENLABS_AGENT_ID="your-agent-id"
ELEVENLABS_AGENT_PHONE_NUMBER_ID="your-agent-phone-number-id"
ELEVENLABS_OUTBOUND_METHOD="twilio"             # twilio | sip_trunk
ELEVENLABS_WEBHOOK_SECRET="your-postcall-webhook-secret"  # verifies ElevenLabs-Signature
ELEVENLABS_STT_MODEL="scribe_v1"     # Scribe model for transcribing recorded handover calls
# Health/credit monitor (worker) — alerts Slack if ElevenLabs is down or low on credits.
ELEVENLABS_MONITOR_MINUTES="15"      # how often the worker probes ElevenLabs
ELEVENLABS_LOW_CREDIT_PCT="90"       # alert when usage reaches this % of the limit
ELEVENLABS_REALERT_HOURS="3"         # while still bad, re-alert at most this often

# ── Internal webhook secret (verifies inbound n8n callbacks) ──
# Also authenticates the billing → CRM invoice webhook (POST /api/webhooks/invoice):
# an invoice is what converts a quote, and it names the branch that earns the credit.
WEBHOOK_SECRET="your-shared-secret"

# ── Global kill-switch for automated AI outbound calls ──
# "true"/"1"/"yes"/"on" pauses ALL automated calls — new-lead intake AND queued
# retries/callbacks. Leads are still captured; nothing is dialled. Rep click-to-call
# is unaffected. Toggle live via the Railway env (no redeploy). Empty/unset = active.
AI_CALLS_PAUSED=""

# ── Call attempt ladder — days to wait before each retry (comma-separated) ──
# "1,5" → attempt 1 at intake (T+0), attempt 2 after 1 day, attempt 3 after 5 days.
# Retries fire only when the previous call was unanswered. Total attempts = list + 1.
RETRY_DELAYS_DAYS="1,5"

# ── Do-not-call window (IST) — no AI calls outside [DND_END_HOUR, DND_START_HOUR) ──
# Defaults: calls allowed 10:00–22:00 IST; leads arriving 22:00–10:00 are held and
# released FIFO at 10:00. Worker concurrency caps how fast the backlog drains.
DND_START_HOUR="22"
DND_END_HOUR="10"
AI_MAX_CONCURRENT_CALLS="10"
# Default hour (IST) for a "call me back" with no specific time — queued + released at this hour.
CALLBACK_HOUR="19"   # 7 PM

# ── Conversation Quality Score (§3.1) — Claude scores every call transcript ──
# Anthropic API key for CQS scoring. Unset = scoring disabled (calls still record).
ANTHROPIC_API_KEY=""
CQS_MODEL="claude-opus-4-8"   # model used to score the rubric (Opus 4.8 by default)

# ── AI→human handover (§3.1) — when an AI call hits a trigger, route to sales ──
# CQS at/above this fast-tracks the lead to a counsellor (not back into drip).
HANDOVER_CQS_THRESHOLD="75"
# Languages the AI agent handles; anything else → manual handover. Codes/names,
# matched on the first token (so "ta-IN"/"Tamil" both count as unsupported here).
HANDOVER_SUPPORTED_LANGUAGES="en,hi"
# SLA: if the assigned rep doesn't act on a handover within this many hours, the
# lead escalates to the counsellor on Slack. A call logged (or the handover
# resolved) before then counts as attended.
HANDOVER_SLA_HOURS="2"
# Where unattended-lead escalations go — a counsellor/supervisor channel id or
# Slack user id. Defaults to SLACK_DEFAULT_CHANNEL when unset.
HANDOVER_ESCALATION_CHANNEL=""
# Counsellor oversight feed (AI handoff / fast-track / threat / premature-lost /
# stuck-in-stage). Channel id or Slack user id; defaults to
# HANDOVER_ESCALATION_CHANNEL, then SLACK_DEFAULT_CHANNEL.
# NOTE: do NOT point this at the sales head — they get their own extremes-only feed
# below. Use a counsellor/ops channel here.
COUNSELLOR_CHANNEL=""
# ── Sales-head escalation (§3.1) — the sales head (SalesRep.salesHead=true) is
# excluded from the round-robin rota and DM'd ONLY when a call scores at these
# CQS extremes: a standout (≥ HIGH) or a quality failure (≤ LOW). ──
SALES_HEAD_CQS_HIGH="90"
SALES_HEAD_CQS_LOW="15"
# Stuck-in-stage SLA: flag a lead that hasn't advanced stage in this many days.
STAGE_SLA_DAYS="7"
# How often the worker scans for stuck leads (hours).
STAGE_SLA_SCAN_HOURS="6"

# ── Branch Manager daily digest (§3.1) ──────────────────────────────
# Where the daily digest is posted — channel id or Slack user id. Defaults to
# SLACK_DEFAULT_CHANNEL when unset.
BRANCH_MANAGER_CHANNEL=""
# Hour (IST, 0–23) the digest is sent each day. Default 9 (09:00 IST), covering
# the previous calendar day.
DIGEST_HOUR_IST="9"

# ── System health monitor (§3.1) — downtime / API-failure alerts ────
# CRM admin recipient for downtime alerts (channel id or Slack user id). Alerts
# also go to BRANCH_MANAGER_CHANNEL. Both fall back to SLACK_DEFAULT_CHANNEL.
CRM_ADMIN_CHANNEL=""
# How often the worker probes subsystems (minutes).
HEALTH_MONITOR_MINUTES="5"
# Consecutive failed probes before declaring a subsystem down (rides out blips).
HEALTH_FAIL_THRESHOLD="2"
# While a subsystem stays down, re-alert at most this often (hours).
HEALTH_REALERT_HOURS="1"

# ── Lead sources ──────────────────────────────────────────────
# Website form (/api/intake/web-form) — optional CORS allowlist (comma-separated origins)
WEB_FORM_ALLOWED_ORIGINS="https://caraclinic.com,https://www.caraclinic.com"

# Pause automated outbound AI calls for specific sources (leads are still captured,
# just not auto-dialed). Comma-separated. Empty = call every source.
# e.g. "facebook,instagram" while Meta App Review is pending.
PAUSE_AUTO_CALL_SOURCES=""

# Meta / Facebook / Instagram Lead Ads (/api/intake/meta)
META_VERIFY_TOKEN="your-webhook-verify-token"      # you choose this; set the same in Meta app
META_APP_SECRET="your-meta-app-secret"             # verifies X-Hub-Signature-256
META_PAGE_ACCESS_TOKEN="your-page-access-token"    # to fetch lead data from the Graph API
META_GRAPH_VERSION="v21.0"

# Google Ads Lead Form (/api/intake/google)
GOOGLE_LEADFORM_KEY="your-google-webhook-key"      # the "Key" set in the Google lead form webhook

# ── WhatsApp Business Cloud API (§3.1.3) — /api/webhooks/whatsapp ──
# Token with whatsapp_business_messaging perm; phone number id from WhatsApp API Setup.
# WHATSAPP_VERIFY_TOKEN: you choose it; set the SAME value in the Meta webhook config.
# Inbound webhook signature reuses META_APP_SECRET (same Meta app).
WHATSAPP_TOKEN="your-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_VERIFY_TOKEN="choose-a-verify-token"
# WABA id — used to list APPROVED templates for the re-engagement picker (Phase 2).
WHATSAPP_WABA_ID="your-whatsapp-business-account-id"

# ── Automated WhatsApp outreach triggers (§3.1.3) ──────────────────────────────
# Each is the name of an APPROVED template; LEAVE EMPTY to disable that trigger.
# Templates should use {{1}} = patient first name (callback also uses {{2}} = time).
# Create + submit them in-app at /templates.
WHATSAPP_TEMPLATE_NEW_LEAD=""      # on new lead → welcome/intro
WHATSAPP_TEMPLATE_CONFIRMED=""     # on AI call confirmed → appointment confirmation
WHATSAPP_TEMPLATE_UNREACHABLE=""   # after all call attempts fail → "we tried to reach you"
WHATSAPP_TEMPLATE_CALLBACK=""      # on callback scheduled → reminder ({{1}}=name, {{2}}=time)

# ── Sharing a quote PDF outside the 24h window (§quote lifecycle) ──
# Inside the window a quote goes out as a plain document message. Outside it, Meta
# only accepts an APPROVED template — one with a DOCUMENT header, whose {{1}} is the
# patient name. LEAVE EMPTY and "Send on WhatsApp" stays disabled on a closed window.
QUOTE_DOC_TEMPLATE_NAME=""         # e.g. quote_document
QUOTE_DOC_TEMPLATE_LANG="en"       # the template's language code

# ── Follow-up campaigns (Phase 2 §follow-up) ──
# Global kill-switch for the WHOLE follow-up engine — enrollment AND sending. OFF by
# default: nothing enrols or messages until this is truthy ("true"/"1"/"yes"/"on"), so
# deploying the code can't start messaging anyone by surprise. Toggle live via env.
CAMPAIGNS_ENABLED=""
# How often (minutes) the worker advances due campaign steps. Default 15.
CAMPAIGN_TICK_MINUTES="15"
# "Couldn't Reach Them" campaign step templates (days 1/5/14/30 → then Lost). Each is the
# name of an APPROVED template; leave empty to skip that step ({{1}} = patient first name).
WHATSAPP_TEMPLATE_CR_DAY1=""       # day 1 after going unreachable
WHATSAPP_TEMPLATE_CR_DAY5=""       # day 5
WHATSAPP_TEMPLATE_CR_DAY14=""      # day 14
WHATSAPP_TEMPLATE_CR_DAY30=""      # day 30 (final touch before Lost)
# "Worried About Cost" — value/financing on days 1/3/7/14 (auto-enrolled from a price signal).
WHATSAPP_TEMPLATE_WC_DAY1=""
WHATSAPP_TEMPLATE_WC_DAY3=""
WHATSAPP_TEMPLATE_WC_DAY7=""
WHATSAPP_TEMPLATE_WC_DAY14=""
# "Just Researching" — weekly educational content, max 6 (auto-enrolled from a warm browse).
WHATSAPP_TEMPLATE_JR_WK1=""
WHATSAPP_TEMPLATE_JR_WK2=""
WHATSAPP_TEMPLATE_JR_WK3=""
WHATSAPP_TEMPLATE_JR_WK4=""
WHATSAPP_TEMPLATE_JR_WK5=""
WHATSAPP_TEMPLATE_JR_WK6=""
# "Win-Back" — one warm message 90 days after Lost (auto sweep, max 4/yr).
WHATSAPP_TEMPLATE_WINBACK=""
# "Dead Lead Bulk" — one "one more try" message (manual approval from the review queue).
WHATSAPP_TEMPLATE_DEADLEAD=""
# Win-back tuning (all optional, sensible defaults):
WINBACK_AFTER_DAYS="90"              # days after Lost before the auto win-back fires
WINBACK_CONSENT_MAX_AGE_DAYS="365"   # marketing consent older than this = expired (skip)
WINBACK_SWEEP_HOURS="12"             # how often the worker runs the win-back sweep

# ── Post-sales ERP care check-ins (§post-sales) ──
# THESE ARE MEDICAL MESSAGES, NOT MARKETING. They are governed by CLINICAL consent, so
# they go out even to a patient who opted out of promotions, and they do NOT count
# against the marketing 12-in-30 ceiling. A patient's clinical consent must not be
# explicitly withheld, and the hard safety flags (possible minor / legal-threat freeze /
# open complaint) turn a check-in into a task for a person rather than an automated send.
#
# Global kill-switch for automated care check-ins. OFF by default: schedules are still
# generated and shown on the journey page, but nothing SENDS until this is "true", so
# deploying the code can't message a post-op patient by surprise.
POSTSALES_CHECKINS_ENABLED=""
# How often (minutes) the worker sends due check-ins. Default 15.
POSTSALES_CHECKIN_TICK_MINUTES="15"
# IST wall-clock hour care messages go out at (0-23, default 10 = 10 AM). A post-op
# check-in should land mid-morning, not whenever its row happens to become due.
POSTSALES_CHECKIN_HOUR_IST="10"
# Approved template per day-offset ({{1}} = patient first name, {{2}} = procedure,
# {{3}} = "day N"). UNSET = that check-in cannot be automated and is flagged on the
# board as needing a person — it is never silently dropped.
POSTSALES_TEMPLATE_CHECKIN_D1=""     # day 1 after surgery
POSTSALES_TEMPLATE_CHECKIN_D7=""     # day 7
POSTSALES_TEMPLATE_CHECKIN_D30=""    # day 30
POSTSALES_TEMPLATE_CHECKIN_D90=""    # day 90
# Fallback for any other day-offset a treatment policy asks for.
POSTSALES_TEMPLATE_CHECKIN_DEFAULT=""
# How often (hours) the worker flags journeys past their per-treatment stage limit and
# reconciles any converted quote that somehow has no journey. Default 6.
POSTSALES_SLA_SCAN_HOURS="6"
# Slack channel for post-sales alerts (overdue clinical stages). Falls back to
# COUNSELLOR_CHANNEL then SLACK_DEFAULT_CHANNEL. Its own channel keeps clinical stalls
# out of the sales feed.
POSTSALES_CHANNEL=""

# ── Twilio click-to-call + recording for AI→human handover (§3.1) ──
# Direct Twilio REST access (separate from ElevenLabs' Twilio usage). The rep is
# rung first; on answer Twilio dials the lead, records, and posts to our webhook.
TWILIO_ACCOUNT_SID="your-twilio-account-sid"   # starts AC...
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_CALLER_ID="+1XXXXXXXXXX"                # a Twilio number you own (caller id)
# Public base URL Twilio calls back on (defaults to NEXTAUTH_URL if unset).
TWILIO_PUBLIC_BASE=""

# ── Inbound calls to the published clinic number (§presence) ──
# The number patients dial from the website. In the Twilio console set that number's
# Voice "A CALL COMES IN" webhook to  <TWILIO_PUBLIC_BASE>/api/twilio/inbound  (HTTP
# POST). Routing (sticky owner → same-speciality colleague → round-robin → hold →
# voicemail) lives in lib/inboundRouting.ts. Used as the caller ID on the rep's leg,
# so a counsellor sees "the clinic" calling and the whisper names the patient.
TWILIO_INBOUND_NUMBER="+91XXXXXXXXXX"
# Seconds one counsellor's phone rings before the call moves down the ladder.
INBOUND_RING_SECONDS="20"
# Seconds the caller is held before one final pass over the whole team.
INBOUND_HOLD_SECONDS="25"
# Spoken greeting before the first connection attempt. Must keep the recording
# disclosure (§compliance C1) if you reword it.
CLINIC_CALL_GREETING=""

# ── Slack staff notifications (§3.1.17) ──
# Bot token from a Slack app with the chat:write scope (starts xoxb-).
# SLACK_DEFAULT_CHANNEL: channel id (e.g. C0123ABCD) or name (#cara-alerts);
# invite the bot to that channel. Leave empty to disable Slack notifications.
SLACK_BOT_TOKEN=""
SLACK_DEFAULT_CHANNEL=""
# App Signing Secret (Slack app → Basic Information). Verifies inbound interactive
# requests (the "Call & record" button) at /api/slack/interact. Enable Interactivity
# in the Slack app and set its Request URL to <base>/api/slack/interact.
SLACK_SIGNING_SECRET=""
