# Cara Clinic — Sales Automation Platform
# Copy to .env.local and fill in. NEVER commit .env.local. (Guide §10)

# ── Database (PostgreSQL + Prisma) ──
DATABASE_URL="postgresql://user:password@localhost:5432/cara_clinic"

# ── Redis (BullMQ broker) ──
REDIS_URL="redis://localhost:6379"

# ── Auth (NextAuth.js / Auth.js v5) ──
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# ── n8n (self-hosted) ──
N8N_WEBHOOK_NEW_LEAD="https://your-n8n.com/webhook/new-lead"
N8N_API_KEY="your-n8n-api-key"

# ── ElevenLabs (Conversational AI — outbound calls + post-call webhook) ──
ELEVENLABS_API_KEY="your-elevenlabs-key"
ELEVENLABS_AGENT_ID="your-agent-id"
ELEVENLABS_AGENT_PHONE_NUMBER_ID="your-agent-phone-number-id"
ELEVENLABS_OUTBOUND_METHOD="twilio"             # twilio | sip_trunk
ELEVENLABS_WEBHOOK_SECRET="your-postcall-webhook-secret"  # verifies ElevenLabs-Signature
# Health/credit monitor (worker) — alerts Slack if ElevenLabs is down or low on credits.
ELEVENLABS_MONITOR_MINUTES="15"      # how often the worker probes ElevenLabs
ELEVENLABS_LOW_CREDIT_PCT="90"       # alert when usage reaches this % of the limit
ELEVENLABS_REALERT_HOURS="3"         # while still bad, re-alert at most this often

# ── Internal webhook secret (verifies inbound n8n callbacks) ──
WEBHOOK_SECRET="your-shared-secret"

# ── Call attempt ladder — days to wait before each retry (comma-separated) ──
# "1,5" → attempt 1 at intake (T+0), attempt 2 after 1 day, attempt 3 after 5 days.
# Retries fire only when the previous call was unanswered. Total attempts = list + 1.
RETRY_DELAYS_DAYS="1,5"

# ── Do-not-call window (IST) — no AI calls outside [DND_END_HOUR, DND_START_HOUR) ──
# Defaults: calls allowed 10:00–22:00 IST; leads arriving 22:00–10:00 are held and
# released FIFO at 10:00. Worker concurrency caps how fast the backlog drains.
DND_START_HOUR="22"
DND_END_HOUR="10"
AI_MAX_CONCURRENT_CALLS="10"
# Default hour (IST) for a "call me back" with no specific time — queued + released at this hour.
CALLBACK_HOUR="19"   # 7 PM

# ── Lead sources ──────────────────────────────────────────────
# Website form (/api/intake/web-form) — optional CORS allowlist (comma-separated origins)
WEB_FORM_ALLOWED_ORIGINS="https://caraclinic.com,https://www.caraclinic.com"

# Pause automated outbound AI calls for specific sources (leads are still captured,
# just not auto-dialed). Comma-separated. Empty = call every source.
# e.g. "facebook,instagram" while Meta App Review is pending.
PAUSE_AUTO_CALL_SOURCES=""

# Meta / Facebook / Instagram Lead Ads (/api/intake/meta)
META_VERIFY_TOKEN="your-webhook-verify-token"      # you choose this; set the same in Meta app
META_APP_SECRET="your-meta-app-secret"             # verifies X-Hub-Signature-256
META_PAGE_ACCESS_TOKEN="your-page-access-token"    # to fetch lead data from the Graph API
META_GRAPH_VERSION="v21.0"

# Google Ads Lead Form (/api/intake/google)
GOOGLE_LEADFORM_KEY="your-google-webhook-key"      # the "Key" set in the Google lead form webhook

# ── WhatsApp Business Cloud API (§3.1.3) — /api/webhooks/whatsapp ──
# Token with whatsapp_business_messaging perm; phone number id from WhatsApp API Setup.
# WHATSAPP_VERIFY_TOKEN: you choose it; set the SAME value in the Meta webhook config.
# Inbound webhook signature reuses META_APP_SECRET (same Meta app).
WHATSAPP_TOKEN="your-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_VERIFY_TOKEN="choose-a-verify-token"

# ── Slack staff notifications (§3.1.17) ──
# Bot token from a Slack app with the chat:write scope (starts xoxb-).
# SLACK_DEFAULT_CHANNEL: channel id (e.g. C0123ABCD) or name (#cara-alerts);
# invite the bot to that channel. Leave empty to disable Slack notifications.
SLACK_BOT_TOKEN=""
SLACK_DEFAULT_CHANNEL=""
